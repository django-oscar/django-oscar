# Copy to .env.prod and fill in. Never commit .env.prod.

# Image tag produced by `docker compose build` (push it to your registry if needed)
IMAGE_NAME=django-oscar-sandbox
IMAGE_TAG=latest
# Port gunicorn listens on, on 127.0.0.1 only (target of the host nginx)
WEB_PORT=8000
# Host directory for uploaded media, served by the host nginx (owned by uid 10001)
MEDIA_DIR=/srv/oscar/media

# Django
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=khafadropshipping.ddns.net
CSRF_TRUSTED_ORIGINS=https://khafadropshipping.ddns.net
# The host nginx already redirects HTTP to HTTPS
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# Set both to false only if the site is served over plain HTTP
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# PostgreSQL (shared by the db and web services)
DATABASE_NAME=oscar
DATABASE_USER=oscar
DATABASE_PASSWORD=change-me

# Load the demo catalogue on first start (empty database only)
LOAD_SANDBOX_DATA=true

# E-mail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ousmane.djigal@gmail.com

EMAIL_SUBJECT_PREFIX=[Oscar sandbox] 
TIME_ZONE=Europe/Paris
LANGUAGE_CODE=fr-fr
OSCAR_DEFAULT_CURRENCY=EUR
OSCAR_SHOP_TAGLINE=Khafa
THUMBNAIL_KEY_PREFIX=oscar-khafa
# Charte graphique : default | sahel | ocean | nuit | minimal | nature
OSCAR_THEME=sahel

#STRIPE 
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...